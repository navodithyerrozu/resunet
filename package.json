{
  "name": "resunet",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered career assistant: resume tailoring, ATS scoring, and application automation.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @resunet/web dev",
    "build": "pnpm --filter @resunet/shared build && pnpm --filter @resunet/web build",
    "lint": "pnpm --filter @resunet/web lint",
    "typecheck": "pnpm -r typecheck",
    "gen:types": "bash scripts/gen-types.sh",
    "clean": "pnpm -r exec rm -rf .next dist node_modules/.cache"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
