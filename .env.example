# ---------------------------------------------------------------------------
# ResuNet environment. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# --- MongoDB --------------------------------------------------------------
# Motor connection string. The replica-set arg is required for transactions,
# which the application-submission flow uses to keep status writes atomic.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=resunet

# --- Redis (ARQ queue broker) ---------------------------------------------
REDIS_URI=redis://localhost:6379/0

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# --- Credential envelope encryption ---------------------------------------
# Fernet key used ONLY by the automation worker to decrypt job-board
# credentials. The API process must NOT be given this key -- see
# docs/ARCHITECTURE.md "Credential isolation".
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- LLM providers --------------------------------------------------------
# LLM_PROVIDER=anthropic (default, needs ANTHROPIC_API_KEY) or ollama
# (local model, no key). With ollama, install Ollama on the host, run
# `ollama pull llama3.1:8b`, and leave OLLAMA_BASE_URL at localhost for a
# local API run -- docker-compose.yml overrides it to host.docker.internal
# for the API container. Restart the API after changing LLM_PROVIDER.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESUME_AGENT_MODEL=claude-sonnet-4-5-20250929
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
RESUME_AGENT_TEMPERATURE=0.2
# Hard ceiling on XYZ repair attempts before a bullet is flagged for review.
XYZ_MAX_REPAIR_ATTEMPTS=3

# --- Rendering ------------------------------------------------------------
# In Docker this MUST be the shared volume path, and the same value in the
# API and the render worker. A relative path resolves to a different folder
# in each container, so the worker's PDF becomes invisible to the API
# preview. For a local non-Docker run, set this to a folder both processes
# actually share.
RENDER_STORAGE_DIR=/srv/storage/renders
LATEX_COMPILE_TIMEOUT_SECONDS=45

# --- Playwright automation ------------------------------------------------
PLAYWRIGHT_HEADLESS=true
AUTOMATION_MAX_ATTEMPTS=3
AUTOMATION_NAV_TIMEOUT_MS=30000
# Residential/ISP proxy. Strongly recommended -- datacenter IPs are the
# single biggest anti-bot trigger on job boards.
AUTOMATION_PROXY_URL=
# Require a human to confirm before the final submit click.
AUTOMATION_REQUIRE_APPROVAL=true

# --- Frontend (must be prefixed NEXT_PUBLIC_ to reach the browser) --------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
